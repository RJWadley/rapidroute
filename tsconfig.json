{
	"extends": "@total-typescript/tsconfig/bundler/dom",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"baseUrl": "./app",
		"paths": {
			"@/*": ["../*"],
			"app/*": ["./*"],
			"trpc/*": ["./api/trpc/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}

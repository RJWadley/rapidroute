{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useSelfClosingElements": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"javascript": { "formatter": { "enabled": true, "semicolons": "asNeeded" } },
	"files": { "ignore": ["pnpm-lock.yaml", "gatelogue"] },
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
